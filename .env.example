# DeepSeek API configuration. Leave DEEPSEEK_API_KEY blank to use local statistics only.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Optional semantic retrieval with Alibaba DashScope embeddings.
# Keep real API keys only in .env, never commit them.
DASHSCOPE_API_KEY=
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_BATCH_SIZE=10
EMBEDDING_TOP_K=40

# Application settings
DATABASE_URL=sqlite:///./instance/appeals.db
AUTO_IMPORT_SAMPLE=true
DEFAULT_PROVINCE=江苏省
DEFAULT_CITY=苏州市
APP_HOST=0.0.0.0
APP_PORT=8000
