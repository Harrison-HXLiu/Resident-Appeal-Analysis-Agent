# Any OpenAI-compatible model API. Leave MODEL_API_KEY blank for deterministic
# local statistics/report fallback. Legacy DEEPSEEK_* variables are supported.
MODEL_PROVIDER=openai-compatible
MODEL_API_KEY=
MODEL_BASE_URL=https://api.deepseek.com
CHAT_MODEL=deepseek-chat
MODEL_TIMEOUT_SECONDS=60
MODEL_MAX_RETRIES=2
# 按所选模型的官方计价填写；0 表示只记录 Token、不估算费用。
MODEL_INPUT_COST_PER_MILLION=0
MODEL_OUTPUT_COST_PER_MILLION=0

# Application settings
DATABASE_URL=sqlite:///./instance/appeals.db
AUTO_IMPORT_SAMPLE=true
DEFAULT_PROVINCE=江苏省
DEFAULT_CITY=苏州市
TAXONOMY_STATUS=trial
AUTH_REQUIRED=false
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
SECURE_COOKIES=false
SESSION_TIMEOUT_MINUTES=30
WORKER_ENABLED=true
PREGENERATE_STANDARD_REPORTS=true
EXTERNAL_SEARCH_ENABLED=false
APP_HOST=0.0.0.0
APP_PORT=8000
